# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL / Neon)
DATABASE_URL=postgres://user:password@localhost:5432/reflex

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate limiting
LOGIN_RATE_LIMIT_POINTS=5
LOGIN_RATE_LIMIT_DURATION_SECONDS=60
